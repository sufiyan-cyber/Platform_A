# ─────────────────────────────────────────────────────────────────────────────
# Agent Forge — environment
# Copy to `.env` and fill in. Everything here is SERVER-ONLY.
# Nothing in this file is prefixed NEXT_PUBLIC_, so nothing reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — your Lyzr Studio API key.
# Get it from https://studio.lyzr.ai → Settings → API Keys.
# Read in exactly one module: src/server/lyzr.ts. Never sent to the client.
LYZR_API_KEY=

# Lyzr Agent API base URL. Override only if you are on a dedicated deployment.
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3

# Lyzr's `provider_id` — the VENDOR, not the model. Lowercase.
# List what your workspace supports with:
#   curl -H "x-api-key: $LYZR_API_KEY" \
#     "https://agent-prod.studio.lyzr.ai/v3/providers/type?provider_type=llm"
LYZR_PROVIDER_ID=openai

# Model for the agent the platform creates for ITSELF (the Mentor).
# Campaign-built agents use whatever the developer picks in the guided flow.
LYZR_MENTOR_MODEL=gpt-4o-mini

# REQUIRED — signing secret for the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Database. Defaults to a local SQLite file — no external service needed.
# For Postgres (e.g. Supabase / Neon / Vercel Postgres):
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. put the connection string here
#   3. run `npm run db:push`
DATABASE_URL="file:./dev.db"

# Web search for campaigns that ground answers in live sources (Tavily).
# Get a key at https://tavily.com — the free tier is enough for development.
# Absent = search-backed campaigns still run, they just answer without sources
# and say so, exactly like LYZR_API_KEY degrades. Read only on the server.
TAVILY_API_KEY=
